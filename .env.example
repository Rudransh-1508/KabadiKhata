# Copy to .env and fill in. Never commit .env.
MOCK_LLM=1                  # 1 = scripted model, no API calls (tests, demos without a key)
LLM_PROVIDER=gemini         # gemini | openai
GEMINI_API_KEY=your-gemini-key
# gemini-2.5-flash is no longer served to new API keys
GEMINI_MODEL_ID=gemini-flash-latest
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL_ID=gpt-4o-mini
# Photo reading: Gemini, then OpenAI, Groq and xAI Grok as fallbacks, using whichever keys are set.
# VISION_PROVIDER=groq      # to try one first (gemini | openai | groq | xai)
GROQ_API_KEY=your-groq-key
# GROQ_API_KEYS=key1,key2,key3   # several keys, used in turn: an exhausted one rests, the next takes over
XAI_API_KEY=your-xai-key
# XAI_VISION_MODEL_ID=grok-4.7
# AGENT_TIMEOUT_S=6           # per agent model call, seconds (read_photo/transcribe use PERCEPTION_TIMEOUT_S)

# Voice (P1): Sarvam speech-to-text for transcribe, and Bulbul TTS for eval clips (dashboard.sarvam.ai)
# VOICE_PROVIDER=sarvam     # sarvam | gemini; unset = sarvam when SARVAM_API_KEY is set, else gemini
SARVAM_API_KEY=your-sarvam-key

# Telegram bot (P4); `make demo` skips the bot while this is empty
TELEGRAM_BOT_TOKEN=

# API (P3)
KK_DB_PATH=data/kk.db
KK_PHOTO_DIR=data/photos
KK_API_URL=http://localhost:3000
# Read-only search copy; leave empty to turn it off
KK_OPENSEARCH_URL=http://localhost:9200

# LLM radar explainer (P2)
# KK_CACHE_DIR=.cache
# LLM_EXPLAIN_TIMEOUT_S=20
